# Browser caching (Netlify also compresses every file with Brotli/Gzip and serves it from its CDN by itself).
# - Files whose name never changes content (fonts, versioned libraries): kept for a year, never re-checked.
#   To change one, give it a new name (e.g. a new version number) and update index.html / sw.js.
# - Icons: kept a week, refreshed in the background.
# - Everything else (index.html, app.js, style.css, ...): Netlify's default, a quick "has it changed?" check on each visit.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/vendor/firebase-12.19.0/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/sortable-1.15.7.min.js
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# always check for a new version of the app
/sw.js
  Cache-Control: no-cache
