rules_version = '2';
// Apex Lift security rules.
// - Each signed-in user can read and change only their own data.
// - The Apex Lift admin account (below) can READ all users' data, for support and app improvement. It can't change it,
//   except for the coach plan (users/{uid}/coach/plan): a routine and/or note the coach sends, which the user's app applies.
// - Coach-only data (templates, private client notes, the admin activity log) can be read and written by the admin only.
// - Coaches (invited by the admin, see COACHING below) can read the account, workouts and presence of the clients who
//   joined them, send them a coach plan, and chat with them (the admin can't read the chats). Never their backups. Only while the admin keeps the coach switched on.
// - Only the data the app actually uses is accepted (known paths, known fields, size limits),
//   so the database can't be filled with junk.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // The admin's User UID (Firebase console → Authentication → Users). To add another admin, add its UID to the list.
    // A User UID is not secret: it only names an account, it can't be used to sign in.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['O5aONnMMOLQI67fNpoNfu9GBrOL2'];
    }
    function fields() {
      return request.resource.data;
    }

    // routines + settings
    match /users/{uid} {
      allow delete: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin() || isCoachOf(uid);
      allow create, update: if isOwner(uid)
        && fields().keys().hasOnly(['plan', 'activeWeek', 'startDay', 'rest', 'showRpe', 'weights', 'custom', 'profile', 'terms', 'body', 'account', 'readiness', 'activity', 'updatedAt']);

      // workout history: one document per exercise
      match /history/{exercise} {
        allow delete: if isOwner(uid);
        allow read: if isOwner(uid) || isAdmin() || isCoachOf(uid);
        allow create, update: if isOwner(uid) && exercise.size() <= 1000
          && fields().keys().hasOnly(['logs', 'del', 'resetAt', 'updatedAt'])
          && fields().logs is list && fields().logs.size() <= 400
          && (!('del' in fields()) || (fields().del is list && fields().del.size() <= 200));
      }

      // account backups (a small summary + the data split into parts)
      match /backups/{backupId} {
        allow delete: if isOwner(uid);
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && fields().keys().hasOnly(['createdAt', 'kind', 'parts', 'workouts', 'exercises', 'routines', 'size'])
          && fields().kind in ['auto', 'manual', 'before-restore', 'before-import', 'before-coach']
          && fields().createdAt is int && fields().workouts is int && fields().exercises is int
          && fields().routines is int && fields().size is int
          && fields().parts is int && fields().parts >= 1 && fields().parts <= 30;

        match /parts/{partId} {
          allow delete: if isOwner(uid);
          allow read: if isOwner(uid) || isAdmin();
          allow create, update: if isOwner(uid)
            && fields().keys().hasOnly(['d'])
            && fields().d is string && fields().d.size() <= 400000;
        }
      }

      // presence + visits: "using the app now" and the last 30 visits (written by the app while it is open)
      match /presence/{docId} {
        allow read: if isOwner(uid) || isAdmin() || isCoachOf(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'app'
          && fields().keys().hasOnly(['at', 'off', 'visits', 'recent'])
          && fields().at is int && fields().off is bool && fields().visits is int
          && fields().recent is list && fields().recent.size() <= 30;
      }

      // coach plan: written by the admin or the user's coach, read by the user's app, which only marks it as applied (appliedAt)
      // coach link: the coach this user joined (written by the user together with coaches/{coach}/members/{uid})
      match /coach/{docId} {
        allow read: if isOwner(uid) || isAdmin() || isCoachOf(uid);
        // The link always names the one coach whose member list has this user: it can only be removed together with
        // that member entry, and changing coach (update) must drop the old coach's entry in the same batch.
        allow delete: if isAdmin()
          || (isOwner(uid) && docId != 'link')
          || (docId == 'link' && (isOwner(uid) || resource.data.coachId == request.auth.uid)
              && !existsAfter(/databases/$(database)/documents/coaches/$(resource.data.coachId)/members/$(uid)));
        allow create, update: if isOwner(uid) && docId == 'link'
          && fields().keys().hasOnly(['coachId', 'coachName', 'code', 'joinedAt'])
          && fields().coachId is string && fields().coachId.size() > 0 && fields().coachId.size() <= 128
          && fields().code is string && fields().code.matches('^[A-HJ-NP-Z2-9]{8}$') && fields().joinedAt is int
          && fields().coachName is string && fields().coachName.size() <= 100
          && existsAfter(/databases/$(database)/documents/coaches/$(fields().coachId)/members/$(uid))
          && (resource == null || resource.data.coachId == fields().coachId
              || !existsAfter(/databases/$(database)/documents/coaches/$(resource.data.coachId)/members/$(uid)));
        // sentAt can't be in the future (a far-future date would block every later plan on the phone)
        allow create, update: if (isAdmin() || isCoachOf(uid)) && docId == 'plan'
          && fields().sentAt is int && fields().sentAt <= request.time.toMillis() + 600000
          && fields().keys().hasOnly(['mode', 'routine', 'targetId', 'activate', 'note', 'coach', 'sentAt', 'appliedAt'])
          && (!('activate' in fields()) || fields().activate is bool)
          && fields().mode in ['add', 'replace', 'note']
          && fields().sentAt is int && fields().appliedAt is int
          && fields().note is string && fields().note.size() <= 1000
          && fields().coach is string && fields().coach.size() <= 100
          && fields().targetId is string && fields().targetId.size() <= 60
          && (fields().mode == 'note' || (fields().routine is map && fields().routine.schedule is list && fields().routine.schedule.size() == 7));
        allow update: if isOwner(uid) && docId == 'plan'
          && fields().diff(resource.data).affectedKeys().hasOnly(['appliedAt'])
          && fields().appliedAt is int;
      }

      // chat with the coach: one thread per coach (users/{uid}/chats/{coachId}), written by the client and that coach
      // only while the client is in the coach's list and the coach is switched on. The admin can't read it.
      // The thread document is a summary (last message, when each side last read it) so lists need one read per client.
      match /chats/{coachId} {
        allow read: if isOwner(uid) || inChat(uid, coachId);
        allow delete: if isOwner(uid);
        allow create, update: if inChat(uid, coachId)
          && fields().keys().hasOnly(['lastAt', 'lastText', 'lastFrom', 'readClient', 'readCoach'])
          && fields().lastAt is int && fields().readClient is int && fields().readCoach is int
          && fields().lastText is string && fields().lastText.size() <= 200
          && fields().lastFrom in [uid, coachId]
          // a new last message is always your own (marking "read" keeps the summary as it was)
          && (fields().lastFrom == request.auth.uid
              || (resource != null && fields().lastFrom == resource.data.lastFrom
                  && fields().lastAt == resource.data.lastAt && fields().lastText == resource.data.lastText))
          // each side marks only its own "read" time
          && (resource == null
              || fields().diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastText', 'lastFrom', isOwner(uid) ? 'readClient' : 'readCoach']));

        match /messages/{msgId} {
          allow read: if isOwner(uid) || inChat(uid, coachId);
          allow delete: if isOwner(uid);
          allow create: if inChat(uid, coachId) && msgId.size() <= 60
            && fields().keys().hasOnly(['from', 'text', 'at'])
            && fields().from == request.auth.uid
            && fields().text is string && fields().text.size() > 0 && fields().text.size() <= 1000
            && fields().at is int && fields().at <= request.time.toMillis() + 600000;
        }
      }
    }

    // the admin page reads everyone's presence with one query (collection group)
    match /{path=**}/presence/{docId} {
      allow read: if isAdmin();
    }

    // routine codes: a routine someone shared with an 8-letter code (just the days and exercises, no workouts).
    // Anyone signed in who knows the code can open it; codes can't be listed or browsed, except your own (to remove
    // them when you delete your account). Only the person who shared it can delete it, and nobody can change it.
    match /shared/{code} {
      allow get: if request.auth != null;
      allow list, delete: if request.auth != null && resource.data.by == request.auth.uid;
      allow create: if request.auth != null && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && fields().keys().hasOnly(['v', 'routine', 'by', 'createdAt'])
        && fields().by == request.auth.uid
        && fields().v is int && fields().createdAt is int
        && fields().routine is map && fields().routine.keys().hasOnly(['name', 'schedule'])
        && fields().routine.name is string && fields().routine.name.size() <= 60
        && fields().routine.schedule is list && fields().routine.schedule.size() == 7;
    }

    // coach: saved routine templates (admin only)
    match /coachTemplates/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && fields().keys().hasOnly(['name', 'routine', 'updatedAt'])
        && fields().name is string && fields().name.size() <= 60
        && fields().routine is map && fields().updatedAt is int;
    }

    // coach: private notes about each client (admin only, never shown to the user)
    match /clients/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && fields().keys().hasOnly(['client', 'notes', 'followUp', 'updatedAt'])
        && fields().client is bool
        && fields().notes is string && fields().notes.size() <= 5000
        && fields().followUp is string && fields().followUp.size() <= 10
        && fields().updatedAt is int;
    }

    // admin activity log: who opened, downloaded or coached which account, and when (can't be changed or deleted)
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && fields().keys().hasOnly(['uid', 'action', 'at', 'by'])
        && fields().uid is string && fields().uid.size() <= 128
        && fields().action in ['view', 'download', 'backup', 'coach', 'notes']
        && fields().at is int && fields().by is string;
    }

    // ===== COACHING =====
    // Coaches are invited by the admin (coachInvites), accept on coach.html, and then coach only the clients who
    // joined them with one of their codes (coaches/{coach}/members/{client}). Switching a coach off (active: false)
    // stops all of their access at once.
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }
    function coachDoc(uid) {
      return /databases/$(database)/documents/coaches/$(uid);
    }
    // signed in as a coach the admin hasn't switched off
    function isCoach() {
      return request.auth != null && exists(coachDoc(request.auth.uid)) && get(coachDoc(request.auth.uid)).data.active == true;
    }
    // signed in as the (switched on) coach this user joined
    function isCoachOf(uid) {
      return isCoach() && exists(/databases/$(database)/documents/coaches/$(request.auth.uid)/members/$(uid));
    }
    // the client and their (switched on) coach, for the chat
    function inChat(uid, coachId) {
      return (isOwner(uid) && exists(/databases/$(database)/documents/coaches/$(coachId)/members/$(uid))
              && get(coachDoc(coachId)).data.active == true)
        || (isOwner(coachId) && isCoachOf(uid));
    }
    function codeDoc(code) {
      return /databases/$(database)/documents/coachCodes/$(code);
    }

    // coach invitations: made by the admin for one email; used once, by that email (verified), to create the coach account
    match /coachInvites/{code} {
      allow read, delete: if isAdmin();
      allow get: if request.auth != null && resource.data.email == myEmail();
      allow create: if isAdmin() && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && fields().keys().hasOnly(['name', 'email', 'by', 'createdAt', 'usedBy', 'usedAt'])
        && fields().name is string && fields().name.size() > 0 && fields().name.size() <= 100
        && fields().email is string && fields().email.size() <= 200 && fields().email == fields().email.lower()
        && fields().by == request.auth.uid && fields().createdAt is int
        && fields().usedBy == '' && fields().usedAt == 0;
      // accepting: in the same batch that creates coaches/{me}
      allow update: if request.auth != null && emailVerified()
        && resource.data.usedBy == '' && resource.data.email == myEmail()
        && fields().diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && fields().usedBy == request.auth.uid && fields().usedAt is int
        && existsAfter(coachDoc(request.auth.uid));
    }

    // coach accounts: created by accepting an invitation; the admin switches them on/off, the coach can change the name
    match /coaches/{coachId} {
      allow read: if isOwner(coachId) || isAdmin();
      allow delete: if isAdmin();
      allow create: if isOwner(coachId) && emailVerified()
        && fields().keys().hasOnly(['name', 'email', 'invite', 'active', 'createdAt'])
        && fields().active == true && fields().createdAt is int
        && fields().name is string && fields().name.size() > 0 && fields().name.size() <= 100
        && fields().invite is string && fields().email == myEmail()
        && get(/databases/$(database)/documents/coachInvites/$(fields().invite)).data.usedBy == ''
        && getAfter(/databases/$(database)/documents/coachInvites/$(fields().invite)).data.usedBy == coachId;
      allow update: if (isAdmin() && fields().diff(resource.data).affectedKeys().hasOnly(['active']) && fields().active is bool)
        || (isOwner(coachId) && fields().diff(resource.data).affectedKeys().hasOnly(['name'])
            && fields().name is string && fields().name.size() > 0 && fields().name.size() <= 100);

      // the coach's clients: a client adds themselves with one of the coach's codes; the client, the coach or the admin removes them
      match /members/{clientId} {
        allow get: if isOwner(clientId) || isAdmin() || (isOwner(coachId) && isCoach());
        allow list: if isAdmin() || (isOwner(coachId) && isCoach());
        // the client drops their entry only together with their link (or when the link names another coach)
        allow delete: if isOwner(coachId) || isAdmin()
          || (isOwner(clientId) && (!existsAfter(/databases/$(database)/documents/users/$(clientId)/coach/link)
              || getAfter(/databases/$(database)/documents/users/$(clientId)/coach/link).data.coachId != coachId));
        // joining: with the client's own email, a real code of this coach, and their link pointing here in the same batch
        allow create: if isOwner(clientId)
          && fields().keys().hasOnly(['code', 'name', 'email', 'joinedAt'])
          && fields().code is string && fields().joinedAt is int
          && fields().name is string && fields().name.size() <= 100
          && fields().email == request.auth.token.get('email', '')
          && getAfter(/databases/$(database)/documents/users/$(clientId)/coach/link).data.coachId == coachId
          && get(codeDoc(fields().code)).data.coach == coachId
          // each code works once: unused before, marked as used by this client in the same batch
          && get(codeDoc(fields().code)).data.get('usedBy', '') == ''
          && getAfter(codeDoc(fields().code)).data.get('usedBy', '') == clientId
          && get(coachDoc(coachId)).data.active == true;
      }

      // the coach's saved routine templates (same shape as coachTemplates)
      match /templates/{id} {
        allow read, delete: if isOwner(coachId) && isCoach();
        allow create, update: if isOwner(coachId) && isCoach()
          && fields().keys().hasOnly(['name', 'routine', 'updatedAt'])
          && fields().name is string && fields().name.size() <= 60
          && fields().routine is map && fields().updatedAt is int;
      }
    }

    // client codes: a coach shares one so a client can join them. Anyone signed in who knows the code can open it;
    // only its coach (or the admin) can list or delete them. Each code works once: joining marks it used (usedBy, usedAt).
    match /coachCodes/{code} {
      allow get: if request.auth != null;
      allow list, delete: if isAdmin() || (request.auth != null && resource.data.coach == request.auth.uid);
      allow create: if isCoach() && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && fields().keys().hasOnly(['coach', 'name', 'createdAt', 'usedBy', 'usedAt'])
        && fields().coach == request.auth.uid && fields().createdAt is int
        && fields().name is string && fields().name.size() <= 100
        && fields().get('usedBy', '') == '' && fields().get('usedAt', 0) == 0;
      // using it: the client marks it, in the same batch that adds them to this coach's list with this code
      allow update: if request.auth != null && resource.data.get('usedBy', '') == ''
        && fields().diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && fields().usedBy == request.auth.uid && fields().usedAt is int
        && getAfter(/databases/$(database)/documents/coaches/$(resource.data.coach)/members/$(request.auth.uid)).data.code == code;
    }

    // the admin page reads every coach's client list with one query (collection group)
    match /{path=**}/members/{clientId} {
      allow read: if isAdmin();
    }

    // everything else is closed
  }
}
